# Maintainer: İzlek contributors
#
# sha256sums is the published GitHub tag archive for v${pkgver}.
# Refresh with: curl -sL "$source_url" | sha256sum
# then makepkg --printsrcinfo > .SRCINFO

pkgname=izlek
pkgver=1.1.0
pkgrel=1
pkgdesc='Local-first film and TV tracking desktop application'
arch=('any')
url='https://github.com/Teknoloji-Filozoflari/Izlek'
license=('GPL-3.0-or-later')
depends=(
  'pyside6'
  'python-alembic'
  'python-httpx'
  'python-keyring'
  'python-pydantic'
  'python-sqlalchemy'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=(
  'python-pytest'
  'python-ruff'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('35bb9c5294b30b8595b2c75a58d3613666025ff10cdabd827eb859ec4512cc68')
_srcdir="Izlek-${pkgver}"

build() {
  cd "${_srcdir}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${_srcdir}"
  QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python -m pytest
  ruff check .
}

package() {
  cd "${_srcdir}"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 src/izlek/resources/desktop/izlek.desktop \
    "$pkgdir/usr/share/applications/izlek.desktop"
  install -Dm644 src/izlek/resources/icons/izlek.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/izlek.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
